# Admin panel access (BROZONE OS)
# Copy to .env.local and fill in. Never commit .env.local.

# Owner password for /admin. Use a long, unique passphrase.
ADMIN_PASSWORD=

# Random signing key for the session cookie — at least 32 bytes.
# Generate with:  openssl rand -base64 48
AUTH_SECRET=

# Google Sheets jako baza (opcjonalne — bez tego panel działa na danych demo)
# Wdróż 04_GOOGLE_SHEETS/apps-script/Code.gs jako aplikację internetową i wklej adres.
SHEETS_API_URL=
SHEETS_API_SECRET=

# Logowanie pracowników przez Google (opcjonalne)
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI:  {APP_URL}/api/auth/google/callback
# Dostęp dostaje wyłącznie adres e-mail wpisany w arkuszu `permissions`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pełny adres aplikacji, bez ukośnika na końcu. Lokalnie: http://localhost:3000
APP_URL=http://localhost:3000

# E-mail właściciela — zawsze ma rolę admin, nawet gdy arkusz permissions jest pusty.
OWNER_EMAIL=
